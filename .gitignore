# 工具/AI 工作区记忆（含潜在敏感，不入库）
.workbuddy/
.playwright-cli/

# 依赖与构建产物
node_modules/

# 数据库与本地数据（server/data 已由 server/.gitignore 覆盖，这里兜底根级）
*.db
*.db-shm
*.db-wal

# 环境变量（含密钥）
.env
.env.local

# 本地生成物（output/ 下除 e2e/ 回归套件外全部忽略）
# 根因：原先整目录忽略 output/，把 21 个 e2e 回归套件一起吞了 —— 清一次 output/ 就全丢。
# 现改为白名单：output/* 忽略，显式放行 output/e2e/（回归套件 + 运行脚本，属源码）；
# shots/ 是运行产物（截图，脚本自建 mkdirSync），继续忽略。
output/*
!output/e2e/
output/e2e/shots/

# 本地参考素材（外部导入，不入版本库）
ref/
