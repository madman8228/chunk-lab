{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "575b1d3a",
      "sentence": "Good morning.",
      "translation": "早晨好。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 0
    },
    {
      "cid": "459a97c6",
      "sentence": "Did the alarm clock go off?",
      "translation": "闹钟响了吗?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 1
    },
    {
      "cid": "f19ef7b9",
      "sentence": "It's time to get up.",
      "translation": "该起床了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 2
    },
    {
      "cid": "d8351b8f",
      "sentence": "Get up soon.",
      "translation": "快起床。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 3
    },
    {
      "cid": "83b90662",
      "sentence": "Are you awake?",
      "translation": "你醒了吗？",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 4
    },
    {
      "cid": "15d444b1",
      "sentence": "Are you feeling sick?",
      "translation": "你不舒服吗?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 5
    },
    {
      "cid": "2869bdb7",
      "sentence": "Did you sleep well?",
      "translation": "睡得好吗?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 6
    },
    {
      "cid": "9d0dc0e2",
      "sentence": "Would you turn off the alarm clock?",
      "translation": "能帮我关掉闹钟吗?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 7
    },
    {
      "cid": "6639c370",
      "sentence": "You finally got up.",
      "translation": "你终于起来了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 8
    },
    {
      "cid": "9b6f06c3",
      "sentence": "It's a nice day!",
      "translation": "今天是个好天!",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 9
    },
    {
      "cid": "6bbeb0ae",
      "sentence": "Did you stay up late last night?",
      "translation": "昨晚你熬夜了?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 10
    },
    {
      "cid": "ebfbfb35",
      "sentence": "Let's fold up the futon.",
      "translation": "把被子叠好。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 11
    },
    {
      "cid": "5aa97ca5",
      "sentence": "You were snoring last night.",
      "translation": "昨天晚上你打呼噜了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 12
    },
    {
      "cid": "bb4458df",
      "sentence": "I had a nightmare.",
      "translation": "我做了个噩梦。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 13
    },
    {
      "cid": "8903d7a3",
      "sentence": "You left the light on.",
      "translation": "你一直没关灯啊。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 14
    },
    {
      "cid": "1a03c159",
      "sentence": "I have to go wash my face.",
      "translation": "我得洗脸了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 15
    },
    {
      "cid": "e00b4267",
      "sentence": "It's time to eat breakfast.",
      "translation": "该吃早饭了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 16
    },
    {
      "cid": "45701dd6",
      "sentence": "I'm still sleepy.",
      "translation": "我还困着呢。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 17
    },
    {
      "cid": "1bc9257b",
      "sentence": "I'm still yawning.",
      "translation": "我还打哈欠呢。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 18
    },
    {
      "cid": "500a1ffd",
      "sentence": "I have a hangover.",
      "translation": "昨天的酒还没醒呢。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 19
    },
    {
      "cid": "2a3883c8",
      "sentence": "I'm a night person.",
      "translation": "我是个夜猫子。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 20
    },
    {
      "cid": "a97a39b3",
      "sentence": "Coffee wakes me up.",
      "translation": "我是用咖啡来提神的。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 21
    },
    {
      "cid": "c9352d0f",
      "sentence": "Did you brush your teeth?",
      "translation": "刷牙了吗?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 22
    },
    {
      "cid": "64930508",
      "sentence": "I have to comb my hair.",
      "translation": "我得梳梳头了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 23
    },
    {
      "cid": "7533e2a5",
      "sentence": "What should I wear?",
      "translation": "穿什么好呢？",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 24
    },
    {
      "cid": "c5321059",
      "sentence": "Hurry up and get dressed.",
      "translation": "快换衣服。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 25
    },
    {
      "cid": "3fd9647b",
      "sentence": "Put those pajamas away!",
      "translation": "把睡衣收好。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 26
    },
    {
      "cid": "e5903674",
      "sentence": "I'm leaving. Bye mom!",
      "translation": "我走了。妈妈再见!",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 27
    },
    {
      "cid": "d510c6f4",
      "sentence": "Let's play hooky today!",
      "translation": "今天我们逃学吧。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 28
    },
    {
      "cid": "6466b1cd",
      "sentence": "You're wearing your sweater inside out.",
      "translation": "你毛衣穿反了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 29
    },
    {
      "cid": "836548b6",
      "sentence": "It's upside down.",
      "translation": "上下颠倒了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 30
    },
    {
      "cid": "bfc4ec88",
      "sentence": "Don't forget to take out the garbage.",
      "translation": "可别忘了扔垃圾!",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 31
    },
    {
      "cid": "54fee80e",
      "sentence": "It's your turn to take out the garbage.",
      "translation": "今天该你扔垃圾了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 32
    },
    {
      "cid": "6457e5c9",
      "sentence": "What are you doing today?",
      "translation": "今天你们干嘛?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 33
    },
    {
      "cid": "21b84221",
      "sentence": "If you don't hurry, we'll be late.",
      "translation": "你快点儿，我们该迟到了!",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 34
    },
    {
      "cid": "10b2694c",
      "sentence": "Hurry or you'll be late for school.",
      "translation": "快点儿，上学该迟到了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 35
    },
    {
      "cid": "9bff447e",
      "sentence": "Did you lock the door?",
      "translation": "你锁门了吗?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 36
    },
    {
      "cid": "1db5a417",
      "sentence": "Aren't you forgetting something?",
      "translation": "没忘了什么东西吧?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 37
    },
    {
      "cid": "1c27ef2a",
      "sentence": "It's already 8:00.",
      "translation": "都已经8点了!",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 38
    },
    {
      "cid": "7747c61b",
      "sentence": "I'm late!",
      "translation": "我晚了!",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 39
    },
    {
      "cid": "a2a29322",
      "sentence": "I have to rush!",
      "translation": "我得赶紧走!",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 40
    },
    {
      "cid": "57f5e766",
      "sentence": "Are you gonna be late today?",
      "translation": "你今天会回来得晚吗?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 41
    },
    {
      "cid": "3be47364",
      "sentence": "What time are you coming home?",
      "translation": "几点回来?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 42
    },
    {
      "cid": "1fa77085",
      "sentence": "Have you got your lunch box?",
      "translation": "饭盒带了吗?",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 43
    },
    {
      "cid": "621d0ce0",
      "sentence": "It might rain today.",
      "translation": "今天好像要下雨。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 44
    },
    {
      "cid": "3aa090c9",
      "sentence": "Don't forget to lock the door when you leave.",
      "translation": "出门的时候，可别忘了锁门。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 45
    },
    {
      "cid": "70190b47",
      "sentence": "Do you mind if I open the window?",
      "translation": "你介意我开下窗吗？",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 46
    },
    {
      "cid": "73225f28",
      "sentence": "I didn't get much sleep last night.",
      "translation": "我昨晚没睡多少觉。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 47
    },
    {
      "cid": "959fa9a7",
      "sentence": "How'd you sleep?",
      "translation": "你睡得怎么样？",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 48
    },
    {
      "cid": "757da6a9",
      "sentence": "You look refreshed.",
      "translation": "你气色不错。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 49
    },
    {
      "cid": "a941aad4",
      "sentence": "Yeah, I slept in.",
      "translation": "嗯，我睡懒觉了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 50
    },
    {
      "cid": "b2921029",
      "sentence": "I woke up at 10.",
      "translation": "我十点醒的。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 51
    },
    {
      "cid": "b613eb7d",
      "sentence": "You feelin' okay?",
      "translation": "感觉还好吗？",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 52
    },
    {
      "cid": "b5a62b5d",
      "sentence": "Super good.",
      "translation": "很好。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 53
    },
    {
      "cid": "21d7bd02",
      "sentence": "Where you goin'?",
      "translation": "你要去哪？",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 54
    },
    {
      "cid": "6e85e8be",
      "sentence": "Out for dinner.",
      "translation": "出去吃晚饭。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 55
    },
    {
      "cid": "22684a18",
      "sentence": "I want you home by 10.",
      "translation": "我要你十点前回家。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 56
    },
    {
      "cid": "7591c63d",
      "sentence": "Yes, ma'am.",
      "translation": "好的，女士。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 57
    },
    {
      "cid": "d68791ff",
      "sentence": "You tired?",
      "translation": "你累了？",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 58
    },
    {
      "cid": "e13305a9",
      "sentence": "I got up late.",
      "translation": "我起晚了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 59
    },
    {
      "cid": "bb4983d7",
      "sentence": "Go clean up.",
      "translation": "去洗漱吧。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 60
    },
    {
      "cid": "2684aa5f",
      "sentence": "Go wash up.",
      "translation": "去洗把脸、洗把手。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 61
    },
    {
      "cid": "c0af9f50",
      "sentence": "Rinse your mouth.",
      "translation": "漱漱口。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 62
    },
    {
      "cid": "5d687bf0",
      "sentence": "Rinse out your mouth.",
      "translation": "把嘴漱干净。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 63
    },
    {
      "cid": "3c1a2036",
      "sentence": "Gargle with water.",
      "translation": "用水漱漱喉咙。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 64
    },
    {
      "cid": "af665333",
      "sentence": "Rinse it.",
      "translation": "冲一冲。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 65
    },
    {
      "cid": "b9c23335",
      "sentence": "Take a shower.",
      "translation": "洗个澡。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 66
    },
    {
      "cid": "73504ae3",
      "sentence": "Dry your hands.",
      "translation": "把手擦干。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 67
    },
    {
      "cid": "54764003",
      "sentence": "Go to the bathroom.",
      "translation": "去上厕所。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 68
    },
    {
      "cid": "e0bd95bb",
      "sentence": "Get out of bed.",
      "translation": "起床了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 69
    },
    {
      "cid": "e082afdd",
      "sentence": "Get dressed.",
      "translation": "穿好衣服。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 70
    },
    {
      "cid": "e31c936a",
      "sentence": "Let's go downstairs.",
      "translation": "下楼吧。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 71
    },
    {
      "cid": "e01f814d",
      "sentence": "Eat something.",
      "translation": "吃点东西。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 72
    },
    {
      "cid": "a80cfc73",
      "sentence": "I'm heading out the door.",
      "translation": "我要出门了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 73
    },
    {
      "cid": "40fa1f77",
      "sentence": "Blow your nose.",
      "translation": "擤鼻涕。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 74
    },
    {
      "cid": "319a8e05",
      "sentence": "Why didn't you wake me?",
      "translation": "为什么不叫醒我？",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 75
    },
    {
      "cid": "85c69d3a",
      "sentence": "I overslept.",
      "translation": "我睡过头了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 76
    },
    {
      "cid": "4aeb9a71",
      "sentence": "I got enough sleep.",
      "translation": "我睡够了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 77
    },
    {
      "cid": "830c8e09",
      "sentence": "Make your bed.",
      "translation": "整理你的床。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 78
    },
    {
      "cid": "f830f35a",
      "sentence": "My alarm's set.",
      "translation": "我闹钟定好了。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 79
    },
    {
      "cid": "31bd739b",
      "sentence": "Sleep in.",
      "translation": "多睡会儿。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 80
    },
    {
      "cid": "257c6484",
      "sentence": "I want to stay in bed for another half an hour.",
      "translation": "我真想在床上多睡半个小时。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 81
    },
    {
      "cid": "3db64270",
      "sentence": "Let me sleep for ten minutes.",
      "translation": "让我再睡十分钟。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 82
    },
    {
      "cid": "4bc148af",
      "sentence": "When do you get up on Saturday?",
      "translation": "星期六你几点起床？",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 83
    },
    {
      "cid": "615604c4",
      "sentence": "I usually sleep late on Saturday.",
      "translation": "我星期六通常晚起。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 84
    },
    {
      "cid": "ad376550",
      "sentence": "I don't want to get up.",
      "translation": "我真不想起床。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 85
    },
    {
      "cid": "2601c5bd",
      "sentence": "It's too early for getting up.",
      "translation": "现在起床还太早。",
      "sourceUrl": "content/oral-1-1-1/oral-001-0347da81a5d5.json",
      "sourceOffset": 86
    },
    {
