{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "3d052989",
      "sentence": "I'll take out the trash after dinner.",
      "translation": "晚饭后我会把垃圾拿出去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 0
    },
    {
      "cid": "1ea989e8",
      "sentence": "The laundry is almost dry now.",
      "translation": "洗的衣服现在差不多干了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 1
    },
    {
      "cid": "e520881b",
      "sentence": "You want some?",
      "translation": "你要来点吗？",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 2
    },
    {
      "cid": "61133093",
      "sentence": "I got it here.",
      "translation": "我这儿有。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 3
    },
    {
      "cid": "7036eef2",
      "sentence": "Veggies are good.",
      "translation": "蔬菜挺好的。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 4
    },
    {
      "cid": "2836375b",
      "sentence": "They have nutrients.",
      "translation": "它们有营养。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 5
    },
    {
      "cid": "3fcc4d24",
      "sentence": "What did you eat?",
      "translation": "你吃了什么？",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 6
    },
    {
      "cid": "1dcd6542",
      "sentence": "Leftover pizza.",
      "translation": "吃剩的披萨。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 7
    },
    {
      "cid": "7849de8e",
      "sentence": "It's homemade.",
      "translation": "自己做的。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 8
    },
    {
      "cid": "382f5358",
      "sentence": "Pretty good.",
      "translation": "挺好吃的。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 9
    },
    {
      "cid": "17386a3e",
      "sentence": "Let's go eat.",
      "translation": "我们去吃吧。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 10
    },
    {
      "cid": "d917bc1b",
      "sentence": "Kay, burgers?",
      "translation": "好，汉堡吗？",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 11
    },
    {
      "cid": "db783c1d",
      "sentence": "It's okay with Mom.",
      "translation": "妈妈同意了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 12
    },
    {
      "cid": "b9aa8c19",
      "sentence": "It's dark in here.",
      "translation": "这里很黑。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 13
    },
    {
      "cid": "89843067",
      "sentence": "Watch your step.",
      "translation": "小心脚下。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 14
    },
    {
      "cid": "7bf57efa",
      "sentence": "Your room's a mess.",
      "translation": "你房间很乱。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 15
    },
    {
      "cid": "e8165154",
      "sentence": "Mom, it's already clean.",
      "translation": "妈，已经很干净了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 16
    },
    {
      "cid": "3243ebfc",
      "sentence": "Stop nagging me.",
      "translation": "别唠叨我了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 17
    },
    {
      "cid": "54010f3c",
      "sentence": "I'll do it soon.",
      "translation": "我很快做。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 18
    },
    {
      "cid": "3a4b732a",
      "sentence": "I like those pants.",
      "translation": "我喜欢那条裤子。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 19
    },
    {
      "cid": "84f32999",
      "sentence": "Try them on.",
      "translation": "穿上试试。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 20
    },
    {
      "cid": "b6567a0a",
      "sentence": "Do I look fat?",
      "translation": "我看起来胖吗？",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 21
    },
    {
      "cid": "13020328",
      "sentence": "You look perfect.",
      "translation": "你看起来很完美。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 22
    },
    {
      "cid": "81537529",
      "sentence": "I couldn't sleep.",
      "translation": "我没睡着。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 23
    },
    {
      "cid": "e72891e5",
      "sentence": "I was up till one.",
      "translation": "我熬到一点。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 24
    },
    {
      "cid": "4231de9f",
      "sentence": "I went to bed early.",
      "translation": "我睡得早。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 25
    },
    {
      "cid": "c093035a",
      "sentence": "Get some more rest.",
      "translation": "多休息一下。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 26
    },
    {
      "cid": "b134e4b0",
      "sentence": "Sleep is important.",
      "translation": "睡眠很重要。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 27
    },
    {
      "cid": "edb7eb4b",
      "sentence": "Have some tea.",
      "translation": "喝点茶。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 28
    },
    {
      "cid": "8c2306cc",
      "sentence": "Come to dinner.",
      "translation": "来吃晚饭。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 29
    },
    {
      "cid": "0f6c6eb5",
      "sentence": "Get off your phone.",
      "translation": "别看手机了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 30
    },
    {
      "cid": "9425b8e6",
      "sentence": "It's getting cold.",
      "translation": "（饭）要凉了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 31
    },
    {
      "cid": "39241d16",
      "sentence": "Warm it up first.",
      "translation": "先热一下。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 32
    },
    {
      "cid": "f82f8fcf",
      "sentence": "Order some food.",
      "translation": "点东西吃。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 33
    },
    {
      "cid": "14713e06",
      "sentence": "Set the table.",
      "translation": "布置桌子（摆餐具）。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 34
    },
    {
      "cid": "de31c7f6",
      "sentence": "Stand up.",
      "translation": "起来（站起来）。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 35
    },
    {
      "cid": "25f410a9",
      "sentence": "Sit down.",
      "translation": "坐下。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 36
    },
    {
      "cid": "2d1e7fe6",
      "sentence": "Let go.",
      "translation": "松手。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 37
    },
    {
      "cid": "f090a897",
      "sentence": "Turn around.",
      "translation": "转过来、转过去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 38
    },
    {
      "cid": "a11e56c2",
      "sentence": "Close your eyes.",
      "translation": "闭上眼睛。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 39
    },
    {
      "cid": "0e10399e",
      "sentence": "Your room's messy.",
      "translation": "你的房间很乱。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 40
    },
    {
      "cid": "e808c2e2",
      "sentence": "Clean your room.",
      "translation": "打扫你的房间。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 41
    },
    {
      "cid": "d403abf3",
      "sentence": "Lock the door.",
      "translation": "把门锁上。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 42
    },
    {
      "cid": "34b89c56",
      "sentence": "Don't mix them up.",
      "translation": "别把它们搞混了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 43
    },
    {
      "cid": "f15b18c1",
      "sentence": "Sort them out.",
      "translation": "把它们分清楚。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 44
    },
    {
      "cid": "bbb7bec1",
      "sentence": "Keep it.",
      "translation": "你留着吧。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 45
    },
    {
      "cid": "b2294826",
      "sentence": "Throw it out.",
      "translation": "把它扔了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 46
    },
    {
      "cid": "c7ea95cd",
      "sentence": "Turn on the lights.",
      "translation": "打开灯。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 47
    },
    {
      "cid": "78e4af03",
      "sentence": "The power's out.",
      "translation": "停电了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 48
    },
    {
      "cid": "fb98228c",
      "sentence": "Mop the floor.",
      "translation": "拖地（擦地板）。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 49
    },
    {
      "cid": "70c23bb5",
      "sentence": "Do the dishes.",
      "translation": "洗碗。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 50
    },
    {
      "cid": "fab59b9a",
      "sentence": "Put it up.",
      "translation": "挂上去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 51
    },
    {
      "cid": "7389fce9",
      "sentence": "Take it down.",
      "translation": "拿下来。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 52
    },
    {
      "cid": "b070daa7",
      "sentence": "Climb up.",
      "translation": "爬上去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 53
    },
    {
      "cid": "b0bc4558",
      "sentence": "Climb down.",
      "translation": "爬下来。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 54
    },
    {
      "cid": "83eb9b90",
      "sentence": "Do the laundry.",
      "translation": "洗衣服。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 55
    },
    {
      "cid": "f1c0fcfb",
      "sentence": "Water the plants.",
      "translation": "给花浇水。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 56
    },
    {
      "cid": "a36e08cb",
      "sentence": "Take it out.",
      "translation": "拿出来。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 57
    },
    {
      "cid": "a73bf6b4",
      "sentence": "Put it back.",
      "translation": "放回去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 58
    },
    {
      "cid": "97500516",
      "sentence": "Don't fall asleep.",
      "translation": "别睡着了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 59
    },
    {
      "cid": "0da18463",
      "sentence": "Don't stay up.",
      "translation": "别熬夜。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 60
    },
    {
      "cid": "bb4458df",
      "sentence": "I had a nightmare.",
      "translation": "我做了个噩梦。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 61
    },
    {
      "cid": "95169b06",
      "sentence": "Go to bed early.",
      "translation": "早点睡。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 62
    },
    {
      "cid": "7d234a10",
      "sentence": "I've been dreaming all night.",
      "translation": "我一直在做梦。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 63
    },
    {
      "cid": "2bb9dcf0",
      "sentence": "When did you go to bed last night?",
      "translation": "你昨晚几点睡的？",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 64
    },
    {
      "cid": "5c36ca37",
      "sentence": "When did you fall asleep?",
      "translation": "你几点睡着的？",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 65
    },
    {
      "cid": "4af03e2d",
      "sentence": "Fold up your bedding.",
      "translation": "把被子叠好。",
      "sourceUrl": "content/oral-1-1-2/oral-001-7228d061d964.json",
      "sourceOffset": 66
    }
  ]
}
