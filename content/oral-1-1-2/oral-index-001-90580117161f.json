{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "a9fb3927",
      "sentence": "I'm home.",
      "translation": "我回来了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 0
    },
    {
      "cid": "317d6281",
      "sentence": "Welcome home!",
      "translation": "你回来了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 1
    },
    {
      "cid": "4d2b6285",
      "sentence": "Did you have a good time?",
      "translation": "今天过得愉快吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 2
    },
    {
      "cid": "fdeaebc9",
      "sentence": "How did it go today?",
      "translation": "今天怎么样?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 3
    },
    {
      "cid": "8c3c197a",
      "sentence": "Can I go out to play?",
      "translation": "我可以出去玩儿会儿吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 4
    },
    {
      "cid": "b889eaa9",
      "sentence": "I'm hungry.",
      "translation": "我饿了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 5
    },
    {
      "cid": "942e60dd",
      "sentence": "Where are the snacks?",
      "translation": "点心在哪儿?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 6
    },
    {
      "cid": "ed4acbb8",
      "sentence": "I'm going to cram school now.",
      "translation": "我去补习学校了啊。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 7
    },
    {
      "cid": "64db5bfc",
      "sentence": "May I have my allowance?",
      "translation": "能给我点儿零花钱吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 8
    },
    {
      "cid": "4630dfdc",
      "sentence": "I'm tired.",
      "translation": "真累啊!",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 9
    },
    {
      "cid": "d642e7de",
      "sentence": "What would you like for dinner?",
      "translation": "晚饭你想吃什么?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 10
    },
    {
      "cid": "ff4ff47a",
      "sentence": "Would you help me set the table?",
      "translation": "你能帮我准备餐具吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 11
    },
    {
      "cid": "7edf2b33",
      "sentence": "What should I make for dinner?",
      "translation": "晚饭做什么好呢?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 12
    },
    {
      "cid": "22305d7e",
      "sentence": "It's good to be home.",
      "translation": "还是家好哇。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 13
    },
    {
      "cid": "10e78ae8",
      "sentence": "Would you run to the store?",
      "translation": "你能不能快点儿去趟商店?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 14
    },
    {
      "cid": "e9798442",
      "sentence": "The bath is ready.",
      "translation": "洗澡水烧好了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 15
    },
    {
      "cid": "1530bc8b",
      "sentence": "I'm taking a shower.",
      "translation": "我要冲个澡。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 16
    },
    {
      "cid": "4ddd2ecd",
      "sentence": "Is dinner ready?",
      "translation": "晚饭好了吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 17
    },
    {
      "cid": "16b2a249",
      "sentence": "Mom, what's for dinner tonight?",
      "translation": "妈妈，今天晚饭吃什么?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 18
    },
    {
      "cid": "0bdb90f7",
      "sentence": "What's for dinner?",
      "translation": "晚饭吃什么?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 19
    },
    {
      "cid": "7c64be12",
      "sentence": "Today, we're having curry.",
      "translation": "今天吃咖哩饭。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 20
    },
    {
      "cid": "61038372",
      "sentence": "How soon can you get it ready?",
      "translation": "还要多久才能做好呀?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 21
    },
    {
      "cid": "e83e2088",
      "sentence": "Let's eat.",
      "translation": "我吃了啊。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 22
    },
    {
      "cid": "f034e8d8",
      "sentence": "Please go ahead.",
      "translation": "请先吃吧。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 23
    },
    {
      "cid": "ccaadcfd",
      "sentence": "This knife cuts well, doesn't it?",
      "translation": "这刀挺好使的，是不是?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 24
    },
    {
      "cid": "30f3a772",
      "sentence": "The water is boiling!",
      "translation": "水开啦!",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 25
    },
    {
      "cid": "594b6c4c",
      "sentence": "Come and get it!",
      "translation": "开饭啦!",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 26
    },
    {
      "cid": "371fdef8",
      "sentence": "It's time to eat.",
      "translation": "该吃饭啦!",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 27
    },
    {
      "cid": "28dbdd8b",
      "sentence": "I'm coming.",
      "translation": "这就来啦!",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 28
    },
    {
      "cid": "f4e7aaf0",
      "sentence": "Did you wash your hands well?",
      "translation": "手洗干净了吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 29
    },
    {
      "cid": "54b3afe3",
      "sentence": "Don't spill it!",
      "translation": "别弄洒了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 30
    },
    {
      "cid": "fd38da20",
      "sentence": "Eat all of your vegetables.",
      "translation": "把碗里的菜吃光。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 31
    },
    {
      "cid": "94e6b14c",
      "sentence": "Finish up your plate.",
      "translation": "把碗里的饭吃干净。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 32
    },
    {
      "cid": "8d9f12c8",
      "sentence": "I don't like asparagus.",
      "translation": "我不喜欢吃芦笋。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 33
    },
    {
      "cid": "92166e03",
      "sentence": "It was very delicious. Thank you.",
      "translation": "谢谢您的款待。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 34
    },
    {
      "cid": "a9919458",
      "sentence": "Would you clear the table?",
      "translation": "能帮我收拾盘子吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 35
    },
    {
      "cid": "70c23bb5",
      "sentence": "Do the dishes.",
      "translation": "洗碗。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 36
    },
    {
      "cid": "28709edd",
      "sentence": "I'll dry the dishes.",
      "translation": "我擦盘子。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 37
    },
    {
      "cid": "f21e1b5a",
      "sentence": "What are you doing?",
      "translation": "你干什么呢?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 38
    },
    {
      "cid": "38b48495",
      "sentence": "I'm watching TV.",
      "translation": "我看电视呢。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 39
    },
    {
      "cid": "51f79667",
      "sentence": "Are there any good programs on TV?",
      "translation": "有什么好看的节目吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 40
    },
    {
      "cid": "91bf7697",
      "sentence": "Nomo is on TV.",
      "translation": "野茂上电视了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 41
    },
    {
      "cid": "939c4aa6",
      "sentence": "What's on Channel 8?",
      "translation": "8频道演什么呢?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 42
    },
    {
      "cid": "c7037ea0",
      "sentence": "Would you change the channel?",
      "translation": "能不能帮我换个台?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 43
    },
    {
      "cid": "7001e3c1",
      "sentence": "I want to watch more TV.",
      "translation": "我还想看电视。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 44
    },
    {
      "cid": "6e76dc28",
      "sentence": "Let's spread out the futon.",
      "translation": "铺床吧。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 45
    },
    {
      "cid": "5fa9ab2c",
      "sentence": "I'm sleepy.",
      "translation": "我困了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 46
    },
    {
      "cid": "eae4719e",
      "sentence": "Did you do your homework?",
      "translation": "作业做了吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 47
    },
    {
      "cid": "5df24c37",
      "sentence": "Study hard.",
      "translation": "好好学习。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 48
    },
    {
      "cid": "55711453",
      "sentence": "Hurry up and go to sleep.",
      "translation": "快点睡觉。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 49
    },
    {
      "cid": "0f5e7d28",
      "sentence": "Enough with your video games.",
      "translation": "游戏玩够了吧。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 50
    },
    {
      "cid": "f13893fa",
      "sentence": "Make sure you brush your teeth.",
      "translation": "一定要刷牙噢。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 51
    },
    {
      "cid": "7fdae9f2",
      "sentence": "Are you ready for tomorrow?",
      "translation": "明天的东西都准备好了吗?",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 52
    },
    {
      "cid": "3326421c",
      "sentence": "I'm going to take a bath.",
      "translation": "我去洗个澡。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 53
    },
    {
      "cid": "505d984d",
      "sentence": "Time to go to sleep.",
      "translation": "该睡觉了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 54
    },
    {
      "cid": "d4aeb80d",
      "sentence": "You left the TV on.",
      "translation": "电视还开着呢。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 55
    },
    {
      "cid": "8e910883",
      "sentence": "Don't leave your stuff here.",
      "translation": "别把你的东西都摊在这儿。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 56
    },
    {
      "cid": "8ddcbec3",
      "sentence": "I set the alarm clock for 8:00.",
      "translation": "把闹钟定在8点了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 57
    },
    {
      "cid": "5c4f0d3d",
      "sentence": "Wake me up at seven tomorrow.",
      "translation": "明天7点叫醒我。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 58
    },
    {
      "cid": "b4bc6200",
      "sentence": "Good night.",
      "translation": "晚安。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 59
    },
    {
      "cid": "cb1fdbb1",
      "sentence": "Sweet dreams.",
      "translation": "做个好梦。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 60
    },
    {
      "cid": "3d052989",
      "sentence": "I'll take out the trash after dinner.",
      "translation": "晚饭后我会把垃圾拿出去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 61
    },
    {
      "cid": "1ea989e8",
      "sentence": "The laundry is almost dry now.",
      "translation": "洗的衣服现在差不多干了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 62
    },
    {
      "cid": "e520881b",
      "sentence": "You want some?",
      "translation": "你要来点吗？",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 63
    },
    {
      "cid": "61133093",
      "sentence": "I got it here.",
      "translation": "我这儿有。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 64
    },
    {
      "cid": "7036eef2",
      "sentence": "Veggies are good.",
      "translation": "蔬菜挺好的。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 65
    },
    {
      "cid": "2836375b",
      "sentence": "They have nutrients.",
      "translation": "它们有营养。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 66
    },
    {
      "cid": "3fcc4d24",
      "sentence": "What did you eat?",
      "translation": "你吃了什么？",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 67
    },
    {
      "cid": "1dcd6542",
      "sentence": "Leftover pizza.",
      "translation": "吃剩的披萨。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 68
    },
    {
      "cid": "7849de8e",
      "sentence": "It's homemade.",
      "translation": "自己做的。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 69
    },
    {
      "cid": "382f5358",
      "sentence": "Pretty good.",
      "translation": "挺好吃的。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 70
    },
    {
      "cid": "17386a3e",
      "sentence": "Let's go eat.",
      "translation": "我们去吃吧。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 71
    },
    {
      "cid": "d917bc1b",
      "sentence": "Kay, burgers?",
      "translation": "好，汉堡吗？",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 72
    },
    {
      "cid": "db783c1d",
      "sentence": "It's okay with Mom.",
      "translation": "妈妈同意了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 73
    },
    {
      "cid": "b9aa8c19",
      "sentence": "It's dark in here.",
      "translation": "这里很黑。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 74
    },
    {
      "cid": "89843067",
      "sentence": "Watch your step.",
      "translation": "小心脚下。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 75
    },
    {
      "cid": "7bf57efa",
      "sentence": "Your room's a mess.",
      "translation": "你房间很乱。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 76
    },
    {
      "cid": "e8165154",
      "sentence": "Mom, it's already clean.",
      "translation": "妈，已经很干净了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 77
    },
    {
      "cid": "3243ebfc",
      "sentence": "Stop nagging me.",
      "translation": "别唠叨我了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 78
    },
    {
      "cid": "54010f3c",
      "sentence": "I'll do it soon.",
      "translation": "我很快做。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 79
    },
    {
      "cid": "3a4b732a",
      "sentence": "I like those pants.",
      "translation": "我喜欢那条裤子。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 80
    },
    {
      "cid": "84f32999",
      "sentence": "Try them on.",
      "translation": "穿上试试。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 81
    },
    {
      "cid": "b6567a0a",
      "sentence": "Do I look fat?",
      "translation": "我看起来胖吗？",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 82
    },
    {
      "cid": "13020328",
      "sentence": "You look perfect.",
      "translation": "你看起来很完美。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 83
    },
    {
      "cid": "81537529",
      "sentence": "I couldn't sleep.",
      "translation": "我没睡着。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 84
    },
    {
      "cid": "e72891e5",
      "sentence": "I was up till one.",
      "translation": "我熬到一点。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 85
    },
    {
      "cid": "4231de9f",
      "sentence": "I went to bed early.",
      "translation": "我睡得早。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 86
    },
    {
      "cid": "c093035a",
      "sentence": "Get some more rest.",
      "translation": "多休息一下。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 87
    },
    {
      "cid": "b134e4b0",
      "sentence": "Sleep is important.",
      "translation": "睡眠很重要。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 88
    },
    {
      "cid": "edb7eb4b",
      "sentence": "Have some tea.",
      "translation": "喝点茶。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 89
    },
    {
      "cid": "8c2306cc",
      "sentence": "Come to dinner.",
      "translation": "来吃晚饭。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 90
    },
    {
      "cid": "0f6c6eb5",
      "sentence": "Get off your phone.",
      "translation": "别看手机了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 91
    },
    {
      "cid": "9425b8e6",
      "sentence": "It's getting cold.",
      "translation": "（饭）要凉了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 92
    },
    {
      "cid": "39241d16",
      "sentence": "Warm it up first.",
      "translation": "先热一下。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 93
    },
    {
      "cid": "f82f8fcf",
      "sentence": "Order some food.",
      "translation": "点东西吃。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 94
    },
    {
      "cid": "14713e06",
      "sentence": "Set the table.",
      "translation": "布置桌子（摆餐具）。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 95
    },
    {
      "cid": "de31c7f6",
      "sentence": "Stand up.",
      "translation": "起来（站起来）。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 96
    },
    {
      "cid": "25f410a9",
      "sentence": "Sit down.",
      "translation": "坐下。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 97
    },
    {
      "cid": "2d1e7fe6",
      "sentence": "Let go.",
      "translation": "松手。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 98
    },
    {
      "cid": "f090a897",
      "sentence": "Turn around.",
      "translation": "转过来、转过去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 99
    },
    {
      "cid": "a11e56c2",
      "sentence": "Close your eyes.",
      "translation": "闭上眼睛。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 100
    },
    {
      "cid": "0e10399e",
      "sentence": "Your room's messy.",
      "translation": "你的房间很乱。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 101
    },
    {
      "cid": "e808c2e2",
      "sentence": "Clean your room.",
      "translation": "打扫你的房间。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 102
    },
    {
      "cid": "d403abf3",
      "sentence": "Lock the door.",
      "translation": "把门锁上。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 103
    },
    {
      "cid": "34b89c56",
      "sentence": "Don't mix them up.",
      "translation": "别把它们搞混了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 104
    },
    {
      "cid": "f15b18c1",
      "sentence": "Sort them out.",
      "translation": "把它们分清楚。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 105
    },
    {
      "cid": "bbb7bec1",
      "sentence": "Keep it.",
      "translation": "你留着吧。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 106
    },
    {
      "cid": "b2294826",
      "sentence": "Throw it out.",
      "translation": "把它扔了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 107
    },
    {
      "cid": "c7ea95cd",
      "sentence": "Turn on the lights.",
      "translation": "打开灯。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 108
    },
    {
      "cid": "78e4af03",
      "sentence": "The power's out.",
      "translation": "停电了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 109
    },
    {
      "cid": "fb98228c",
      "sentence": "Mop the floor.",
      "translation": "拖地（擦地板）。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 110
    },
    {
      "cid": "fab59b9a",
      "sentence": "Put it up.",
      "translation": "挂上去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 111
    },
    {
      "cid": "7389fce9",
      "sentence": "Take it down.",
      "translation": "拿下来。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 112
    },
    {
      "cid": "b070daa7",
      "sentence": "Climb up.",
      "translation": "爬上去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 113
    },
    {
      "cid": "b0bc4558",
      "sentence": "Climb down.",
      "translation": "爬下来。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 114
    },
    {
      "cid": "83eb9b90",
      "sentence": "Do the laundry.",
      "translation": "洗衣服。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 115
    },
    {
      "cid": "f1c0fcfb",
      "sentence": "Water the plants.",
      "translation": "给花浇水。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 116
    },
    {
      "cid": "a36e08cb",
      "sentence": "Take it out.",
      "translation": "拿出来。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 117
    },
    {
      "cid": "a73bf6b4",
      "sentence": "Put it back.",
      "translation": "放回去。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 118
    },
    {
      "cid": "97500516",
      "sentence": "Don't fall asleep.",
      "translation": "别睡着了。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 119
    },
    {
      "cid": "0da18463",
      "sentence": "Don't stay up.",
      "translation": "别熬夜。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 120
    },
    {
      "cid": "95169b06",
      "sentence": "Go to bed early.",
      "translation": "早点睡。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 121
    },
    {
      "cid": "7d234a10",
      "sentence": "I've been dreaming all night.",
      "translation": "我一直在做梦。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 122
    },
    {
      "cid": "2bb9dcf0",
      "sentence": "When did you go to bed last night?",
      "translation": "你昨晚几点睡的？",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 123
    },
    {
      "cid": "5c36ca37",
      "sentence": "When did you fall asleep?",
      "translation": "你几点睡着的？",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 124
    },
    {
      "cid": "4af03e2d",
      "sentence": "Fold up your bedding.",
      "translation": "把被子叠好。",
      "sourceUrl": "content/oral-1-1-2/oral-001-c59fb9cff85f.json",
      "sourceOffset": 125
    }
  ]
}
