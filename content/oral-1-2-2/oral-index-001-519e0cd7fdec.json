{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "c2d2b0e9",
      "sentence": "I'd like to play golf.",
      "translation": "我想打高尔夫球。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 0
    },
    {
      "cid": "c02899b7",
      "sentence": "Would you like to golf tomorrow?",
      "translation": "明天打高尔夫球，好吗?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 1
    },
    {
      "cid": "59f2b10f",
      "sentence": "Do you want to join me?",
      "translation": "愿意和我一起打高尔夫球吗?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 2
    },
    {
      "cid": "dea1cbb9",
      "sentence": "Are there any golf courses around here?",
      "translation": "这附近有高尔夫球场地吗?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 3
    },
    {
      "cid": "09976f4e",
      "sentence": "How much is it per person?",
      "translation": "1个人多少钱?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 4
    },
    {
      "cid": "40f9bf2f",
      "sentence": "How much is it per day?",
      "translation": "1天多少钱?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 5
    },
    {
      "cid": "fa2c1bb7",
      "sentence": "Are there any extra charges?",
      "translation": "此外还有其它的花费吗?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 6
    },
    {
      "cid": "f6172d77",
      "sentence": "Can I rent the equipment?",
      "translation": "我可以租用用具吗?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 7
    },
    {
      "cid": "acd0a557",
      "sentence": "Please make a reservation for golf.",
      "translation": "请帮我预约高尔夫球。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 8
    },
    {
      "cid": "6da6c48a",
      "sentence": "I'd like to make golf reservations.",
      "translation": "我想预约高尔夫球。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 9
    },
    {
      "cid": "ec3d01d4",
      "sentence": "When would you like to play?",
      "translation": "要什么时间的?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 10
    },
    {
      "cid": "6094fb88",
      "sentence": "This Friday, if possible.",
      "translation": "如果可以的话，(请订这个星期五的。)",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 11
    },
    {
      "cid": "c66d2828",
      "sentence": "There are four of us.",
      "translation": "我们一共4个人。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 12
    },
    {
      "cid": "89ce6783",
      "sentence": "What time are we starting?",
      "translation": "我们几点开始?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 13
    },
    {
      "cid": "22e35f9a",
      "sentence": "How about a drink?",
      "translation": "去喝一杯怎么样?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 14
    },
    {
      "cid": "6274bb39",
      "sentence": "I need a drink.",
      "translation": "我想去喝一杯。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 15
    },
    {
      "cid": "6cd96cc4",
      "sentence": "Would you like to have a drink after work?",
      "translation": "下班以后去喝一杯怎么样?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 16
    },
    {
      "cid": "ce69b2ee",
      "sentence": "Do you have any beer?",
      "translation": "有啤酒吗?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 17
    },
    {
      "cid": "b8170c87",
      "sentence": "Two bottles of beer, please.",
      "translation": "请来两瓶啤酒。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 18
    },
    {
      "cid": "7d2961ec",
      "sentence": "One whiskey with water, please.",
      "translation": "请来杯掺水的威士忌。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 19
    },
    {
      "cid": "97a75be5",
      "sentence": "What kind of snacks should we have?",
      "translation": "要什么下酒菜呢?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 20
    },
    {
      "cid": "01dd38a3",
      "sentence": "Let's forget about work and have some fun.",
      "translation": "让我们忘了工作，痛快一会儿吧。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 21
    },
    {
      "cid": "0aaab58e",
      "sentence": "Cheers!",
      "translation": "干杯!",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 22
    },
    {
      "cid": "63a95869",
      "sentence": "What are you drinking?",
      "translation": "喝什么呢?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 23
    },
    {
      "cid": "805e08c4",
      "sentence": "I like to go barhopping.",
      "translation": "我喜欢换酒馆喝。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 24
    },
    {
      "cid": "00baf754",
      "sentence": "The first sip is the best!",
      "translation": "第一口最舒坦了。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 25
    },
    {
      "cid": "e1e65f38",
      "sentence": "Nothing beats this!",
      "translation": "这个最好!",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 26
    },
    {
      "cid": "7cb47e46",
      "sentence": "Would you like a refill?",
      "translation": "再来一杯，怎么样?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 27
    },
    {
      "cid": "a18757ae",
      "sentence": "Another beer, please.",
      "translation": "再来一瓶啤酒!",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 28
    },
    {
      "cid": "88c28a4e",
      "sentence": "This whiskey is strong.",
      "translation": "这种威士忌挺冲。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 29
    },
    {
      "cid": "1a879699",
      "sentence": "How do you like sake?",
      "translation": "日本酒怎么样?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 30
    },
    {
      "cid": "b9fa7655",
      "sentence": "It's strong.",
      "translation": "酒劲大。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 31
    },
    {
      "cid": "e4555fac",
      "sentence": "I'm drunk.",
      "translation": "我喝醉了。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 32
    },
    {
      "cid": "68092f2a",
      "sentence": "I feel a little tipsy.",
      "translation": "我觉得有点儿醉了。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 33
    },
    {
      "cid": "b2373a55",
      "sentence": "I'm loaded.",
      "translation": "酩酊大醉。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 34
    },
    {
      "cid": "62eaf1c9",
      "sentence": "Drink moderately.",
      "translation": "喝酒要适可而止。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 35
    },
    {
      "cid": "8a183357",
      "sentence": "I get drunk easily.",
      "translation": "我的酒量小。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 36
    },
    {
      "cid": "1d3ebcf9",
      "sentence": "I drank too much.",
      "translation": "我喝得太多了。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 37
    },
    {
      "cid": "6a74e470",
      "sentence": "I should have drunk less.",
      "translation": "我不该喝这么多的。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 38
    },
    {
      "cid": "18703ae0",
      "sentence": "Let's go to karaoke!",
      "translation": "我们去唱卡拉OK吧。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 39
    },
    {
      "cid": "ef864d54",
      "sentence": "What is karaoke?",
      "translation": "什么是卡拉OK?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 40
    },
    {
      "cid": "ef019226",
      "sentence": "Singing along with recorded music.",
      "translation": "就是合着录音带的音乐一起唱歌。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 41
    },
    {
      "cid": "82c199de",
      "sentence": "Are you good at singing?",
      "translation": "你唱歌拿手吗?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 42
    },
    {
      "cid": "1f43d8f0",
      "sentence": "I'd like to request a song.",
      "translation": "我想点首歌。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 43
    },
    {
      "cid": "3f87fa81",
      "sentence": "You sing first.",
      "translation": "你先唱。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 44
    },
    {
      "cid": "5eab8463",
      "sentence": "Let's enjoy ourselves.",
      "translation": "大家高兴地玩吧!",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 45
    },
    {
      "cid": "7f74511e",
      "sentence": "How about a song, John?",
      "translation": "约翰，你来唱一首吧。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 46
    },
    {
      "cid": "4a04c385",
      "sentence": "What are you going to sing?",
      "translation": "你打算唱什么歌?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 47
    },
    {
      "cid": "0a64bf4c",
      "sentence": "Let's sing a duet.",
      "translation": "来个二重唱吧。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 48
    },
    {
      "cid": "4eaed82b",
      "sentence": "Now it's my turn.",
      "translation": "现在轮到我了。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 49
    },
    {
      "cid": "6b54aa75",
      "sentence": "I don't have the nerve to sing in front of people.",
      "translation": "我不敢在大家面前唱歌。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 50
    },
    {
      "cid": "aaf4a5e4",
      "sentence": "I can't keep up with the new songs.",
      "translation": "我跟不上新歌的速度(我不会唱新歌。)",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 51
    },
    {
      "cid": "bf0a8c7b",
      "sentence": "I'm tone-deaf.",
      "translation": "我五音不全。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 52
    },
    {
      "cid": "d0de4c97",
      "sentence": "What's your karaoke specialty?",
      "translation": "你唱卡拉OK有什么拿手的歌吗?",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 53
    },
    {
      "cid": "0accd0c1",
      "sentence": "I've never heard of that song.",
      "translation": "我从来没听说过那首歌。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 54
    },
    {
      "cid": "3b12a8ff",
      "sentence": "You're a good singer!",
      "translation": "你唱得真好!",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 55
    },
    {
      "cid": "7e998d83",
      "sentence": "We went hiking last Sunday.",
      "translation": "上周日我们去徒步了。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 56
    },
    {
      "cid": "48a08dbe",
      "sentence": "Have you seen the latest movie yet?",
      "translation": "你看过那部最新的电影了吗？",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 57
    },
    {
      "cid": "f265bd24",
      "sentence": "The book is way better than the movie.",
      "translation": "这本书比电影好看多了。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 58
    },
    {
      "cid": "574f6eb0",
      "sentence": "I can't put this novel down.",
      "translation": "这本小说让我爱不释手。",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 59
    },
    {
      "cid": "56db8fc9",
      "sentence": "How about the movies?",
      "translation": "看电影怎么样？",
      "sourceUrl": "content/oral-1-2-2/oral-001-8dc59e656b8d.json",
      "sourceOffset": 60
    }
  ]
}
