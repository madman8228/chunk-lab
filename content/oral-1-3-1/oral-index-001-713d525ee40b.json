{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "6e1a797a",
      "sentence": "Do you need a doctor?",
      "translation": "用叫医生吗?",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 0
    },
    {
      "cid": "d109b3d8",
      "sentence": "Please call an ambulance.",
      "translation": "请叫救护车。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 1
    },
    {
      "cid": "84adbe48",
      "sentence": "I'd like to see a doctor.",
      "translation": "我要看病。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 2
    },
    {
      "cid": "b9af65ab",
      "sentence": "I'm not feeling well.",
      "translation": "我不舒服。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 3
    },
    {
      "cid": "121a9c6a",
      "sentence": "Could you send me a doctor?",
      "translation": "你能帮我请位医生吗?",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 4
    },
    {
      "cid": "077f60e8",
      "sentence": "What's wrong with you?",
      "translation": "你怎么啦?",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 5
    },
    {
      "cid": "90fcc339",
      "sentence": "What are your symptoms?",
      "translation": "是什么症状?",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 6
    },
    {
      "cid": "f08e4511",
      "sentence": "Let me check your temperature.",
      "translation": "量一下体温吧。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 7
    },
    {
      "cid": "4d934ced",
      "sentence": "Did you eat something unusual?",
      "translation": "吃了什么不对劲的东西没有?",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 8
    },
    {
      "cid": "606ed174",
      "sentence": "Let me check your blood pressure.",
      "translation": "量一下血压吧。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 9
    },
    {
      "cid": "42ed2f99",
      "sentence": "Are you taking any medication regularly?",
      "translation": "你常服用什么药?",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 10
    },
    {
      "cid": "cb4ef5fa",
      "sentence": "I'm not taking any medication.",
      "translation": "我没服用任何药。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 11
    },
    {
      "cid": "cab09bff",
      "sentence": "What's wrong with me?",
      "translation": "我哪儿不好?",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 12
    },
    {
      "cid": "e540bba9",
      "sentence": "Is it serious?",
      "translation": "严重吗?",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 13
    },
    {
      "cid": "f5a21d52",
      "sentence": "How long have you been feeling like this?",
      "translation": "你这样感觉有多久了？",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 14
    },
    {
      "cid": "2f17c3e6",
      "sentence": "Have you taken anything for it?",
      "translation": "你吃过什么药吗？",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 15
    },
    {
      "cid": "c55bb082",
      "sentence": "You'd better get some rest and drink plenty of water.",
      "translation": "你最好休息一下，多喝水。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 16
    },
    {
      "cid": "3e523059",
      "sentence": "Does it hurt when I press here?",
      "translation": "我按这里会疼吗？",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 17
    },
    {
      "cid": "0e4cb67e",
      "sentence": "Let's take your temperature.",
      "translation": "量一下你的体温吧。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 18
    },
    {
      "cid": "1d4b7d2d",
      "sentence": "Did you eat something bad?",
      "translation": "你是不是吃坏东西了？",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 19
    },
    {
      "cid": "45ae00d9",
      "sentence": "Are you sick?",
      "translation": "你生病了吗？",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 20
    },
    {
      "cid": "dc756c88",
      "sentence": "Take some medicine.",
      "translation": "吃点药。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 21
    },
    {
      "cid": "7fdbc9e4",
      "sentence": "Where does it hurt?",
      "translation": "哪里疼？",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 22
    },
    {
      "cid": "9dd8fc89",
      "sentence": "Is it your stomach?",
      "translation": "是肚子吗？",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 23
    },
    {
      "cid": "0d637f69",
      "sentence": "Take a rest.",
      "translation": "休息一下。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 24
    },
    {
      "cid": "f863d500",
      "sentence": "Have some water.",
      "translation": "喝点水。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 25
    },
    {
      "cid": "6c5b5c7b",
      "sentence": "Lie down.",
      "translation": "躺下。",
      "sourceUrl": "content/oral-1-3-1/oral-001-d30c57dcf59c.json",
      "sourceOffset": 26
    }
  ]
}
