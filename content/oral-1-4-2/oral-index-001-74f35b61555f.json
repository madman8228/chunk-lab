{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "a5a2f9cc",
      "sentence": "Will you marry me?",
      "translation": "愿意和我结婚吗?",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 0
    },
    {
      "cid": "d6a36ed8",
      "sentence": "I don't want to get engaged yet.",
      "translation": "我还不想订婚。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 1
    },
    {
      "cid": "98fb73d3",
      "sentence": "I don't want to get married yet.",
      "translation": "我还不想结婚。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 2
    },
    {
      "cid": "49de12a3",
      "sentence": "I haven't thought about marriage yet.",
      "translation": "结婚，我还没想过呢。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 3
    },
    {
      "cid": "39ea312a",
      "sentence": "I love you but I can't marry you.",
      "translation": "我爱你，可是不能和你结婚。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 4
    },
    {
      "cid": "c5dedc14",
      "sentence": "I hesitate to marry her.",
      "translation": "我还下不了决心和她结婚。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 5
    },
    {
      "cid": "dc11e094",
      "sentence": "He's a newlywed.",
      "translation": "他刚刚结婚。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 6
    },
    {
      "cid": "f28619f5",
      "sentence": "How's your married life?",
      "translation": "婚后生活怎么样?",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 7
    },
    {
      "cid": "d643a6b9",
      "sentence": "We're happy together now.",
      "translation": "我们俩都感到很幸福。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 8
    },
    {
      "cid": "d9bd2bdf",
      "sentence": "I love my wife.",
      "translation": "我很爱我的妻子。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 9
    },
    {
      "cid": "c23de3a5",
      "sentence": "We're two of a kind.",
      "translation": "我们夫妻俩性格相似。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 10
    },
    {
      "cid": "001d3c9b",
      "sentence": "We're a well-matched couple.",
      "translation": "我们俩很般配。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 11
    },
    {
      "cid": "dff3d3a5",
      "sentence": "I'm a family-centered person.",
      "translation": "我是个顾家的人。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 12
    },
    {
      "cid": "a78bb49a",
      "sentence": "She wants to start a family.",
      "translation": "她想要个孩子。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 13
    },
    {
      "cid": "060e83f5",
      "sentence": "I'm pregnant.",
      "translation": "我怀孕了。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 14
    },
    {
      "cid": "6ef2b67f",
      "sentence": "What did she have?",
      "translation": "怀的是男孩还是女孩?",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 15
    },
    {
      "cid": "6e5e708d",
      "sentence": "We can work it out.",
      "translation": "问题总会解决的。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 16
    },
    {
      "cid": "de0b23c2",
      "sentence": "I think of my wife first.",
      "translation": "我首先想到的是我妻子。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 17
    },
    {
      "cid": "3c55698b",
      "sentence": "We as a husband and a wife don't have any fights.",
      "translation": "我们夫妻从不吵架。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 18
    },
    {
      "cid": "7a961d91",
      "sentence": "Family man.",
      "translation": "拖家带口的人。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 19
    },
    {
      "cid": "3f7ea1d3",
      "sentence": "We fight a lot.",
      "translation": "我们经常吵架。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 20
    },
    {
      "cid": "88953dfa",
      "sentence": "I don't love my wife any more.",
      "translation": "我不再爱我的妻子了。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 21
    },
    {
      "cid": "f7f71cb4",
      "sentence": "My wife's cheating on me.",
      "translation": "我老婆有外遇。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 22
    },
    {
      "cid": "1e55aebd",
      "sentence": "We had a falling-out.",
      "translation": "我们感情不和。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 23
    },
    {
      "cid": "7cdb4218",
      "sentence": "I've changed my mind.",
      "translation": "我已经改变心意了。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 24
    },
    {
      "cid": "4091ff7c",
      "sentence": "You have changed.",
      "translation": "你变了。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 25
    },
    {
      "cid": "61dfc8e8",
      "sentence": "Are you seeing someone now?",
      "translation": "你现在是不是和谁交往呢?",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 26
    },
    {
      "cid": "0a1bf683",
      "sentence": "I don't see eye to eye with my wife.",
      "translation": "我和妻子没什么共同语言。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 27
    },
    {
      "cid": "7ca24be4",
      "sentence": "We just don't get along.",
      "translation": "我们俩合不来了。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 28
    },
    {
      "cid": "cd2b6952",
      "sentence": "I thought I knew you.",
      "translation": "我想我很了解你。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 29
    },
    {
      "cid": "e4e57bed",
      "sentence": "I had an affair with my secretary.",
      "translation": "我和我的秘书有了婚外情。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 30
    },
    {
      "cid": "a7ac79e5",
      "sentence": "I don't enjoy being with you.",
      "translation": "和你在一起没意思。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 31
    },
    {
      "cid": "368558ec",
      "sentence": "Let's get divorced.",
      "translation": "我们离婚吧。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 32
    },
    {
      "cid": "af4053b8",
      "sentence": "I'm separated from my wife.",
      "translation": "现在我和我妻子分居了。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 33
    },
    {
      "cid": "730cddfc",
      "sentence": "I can't get over losing you.",
      "translation": "我不能失去你。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 34
    },
    {
      "cid": "14208828",
      "sentence": "Breaking up is hard to do.",
      "translation": "和你分手是我最大的痛苦。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 35
    },
    {
      "cid": "8ff6ee26",
      "sentence": "Don't break my heart.",
      "translation": "请不要伤我的心。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 36
    },
    {
      "cid": "e8dbcb19",
      "sentence": "We argued for hours.",
      "translation": "我们争论了好几个小时。",
      "sourceUrl": "content/oral-1-4-2/oral-001-310b373dee12.json",
      "sourceOffset": 37
    }
  ]
}
