{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "ec1f2115",
      "sentence": "I made it!",
      "translation": "我赶上了!",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 0
    },
    {
      "cid": "7fddf895",
      "sentence": "Be punctual!",
      "translation": "要严格遵守时间。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 1
    },
    {
      "cid": "9632e6ac",
      "sentence": "You are late again.",
      "translation": "你又迟到了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 2
    },
    {
      "cid": "ffbfaec5",
      "sentence": "I was only late by five minutes.",
      "translation": "我只迟到了5分钟。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 3
    },
    {
      "cid": "51df1ffd",
      "sentence": "Did you punch in?",
      "translation": "打出勤卡了吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 4
    },
    {
      "cid": "873cfa3e",
      "sentence": "Did you punch out?",
      "translation": "打出勤卡了吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 5
    },
    {
      "cid": "acee3473",
      "sentence": "Let me check my schedule.",
      "translation": "让我看看我的日程安排。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 6
    },
    {
      "cid": "c118a103",
      "sentence": "I've got so much to do.",
      "translation": "我有好多事要干。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 7
    },
    {
      "cid": "68b9fb50",
      "sentence": "I'm pressed for time.",
      "translation": "我的时间安排很紧。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 8
    },
    {
      "cid": "66b27ffd",
      "sentence": "I'm an ordinary office worker.",
      "translation": "我是个普通的公司职员。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 9
    },
    {
      "cid": "ae926e9a",
      "sentence": "The work doesn't need much effort.",
      "translation": "这工作不太费事。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 10
    },
    {
      "cid": "a62fa405",
      "sentence": "Don't neglect your duties!",
      "translation": "干活别偷懒。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 11
    },
    {
      "cid": "94a8f5a3",
      "sentence": "I take charge of the west side.",
      "translation": "西区由我负责。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 12
    },
    {
      "cid": "63dd9cc2",
      "sentence": "I'm done with the work.",
      "translation": "我已结束那项工作了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 13
    },
    {
      "cid": "f8ddc168",
      "sentence": "I can still work for a long time.",
      "translation": "我还能工作好长时间呢。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 14
    },
    {
      "cid": "e3bfc522",
      "sentence": "Our boss has been fired.",
      "translation": "我们的上司被解雇了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 15
    },
    {
      "cid": "7a6fcbff",
      "sentence": "Please staple these together.",
      "translation": "请把这个订在一起。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 16
    },
    {
      "cid": "c8624b8d",
      "sentence": "Would you copy these papers?",
      "translation": "能帮我复印一下这份材料吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 17
    },
    {
      "cid": "63726b88",
      "sentence": "This copy machine doesn't work.",
      "translation": "复印机有毛病了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 18
    },
    {
      "cid": "8d129c97",
      "sentence": "I think it ran out of paper.",
      "translation": "我想复印机是没纸了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 19
    },
    {
      "cid": "a2742647",
      "sentence": "Let's take a break.",
      "translation": "我们休息一会儿吧。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 20
    },
    {
      "cid": "4cfc8999",
      "sentence": "Get me a cup of coffee, will you?",
      "translation": "能帮我倒杯咖啡吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 21
    },
    {
      "cid": "78864d39",
      "sentence": "Would you like some coffee?",
      "translation": "您想喝杯咖啡吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 22
    },
    {
      "cid": "699f68bf",
      "sentence": "That would be great.",
      "translation": "那真是太好了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 23
    },
    {
      "cid": "3c28ea21",
      "sentence": "It's almost lunchtime.",
      "translation": "快到午饭时间了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 24
    },
    {
      "cid": "0adc8892",
      "sentence": "We took an hour lunch break.",
      "translation": "我们有1小时的午休时间。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 25
    },
    {
      "cid": "d951b2e9",
      "sentence": "Let's get started.",
      "translation": "我们开始吧。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 26
    },
    {
      "cid": "26dbed9b",
      "sentence": "I can't leave this job at the moment.",
      "translation": "现在我不能放下这个工作。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 27
    },
    {
      "cid": "c2dd30e1",
      "sentence": "I'm too busy to bother with such details.",
      "translation": "我太忙了，顾不上那么琐碎的事。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 28
    },
    {
      "cid": "1522a3a1",
      "sentence": "I'm so busy, I'd really appreciate any help I could get.",
      "translation": "我忙得四脚朝天。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 29
    },
    {
      "cid": "5d3a3983",
      "sentence": "Don't slack off!",
      "translation": "别偷懒!",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 30
    },
    {
      "cid": "9e63f7a2",
      "sentence": "Do your best!",
      "translation": "尽你的全力!",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 31
    },
    {
      "cid": "a2b8b2d5",
      "sentence": "Don't work too hard.",
      "translation": "悠着点儿。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 32
    },
    {
      "cid": "6576ae63",
      "sentence": "Pull yourself together.",
      "translation": "打起精神来。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 33
    },
    {
      "cid": "8f00cb22",
      "sentence": "You can count on me.",
      "translation": "你可以找我呀!",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 34
    },
    {
      "cid": "e8d2634d",
      "sentence": "I don't even have time to catch my breath.",
      "translation": "连喘口气的工夫都没有。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 35
    },
    {
      "cid": "be405ede",
      "sentence": "What's keeping you?",
      "translation": "你怎么耽搁了?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 36
    },
    {
      "cid": "4956bbd4",
      "sentence": "Changing jobs is the only way out.",
      "translation": "换个工作是惟一的解决办法。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 37
    },
    {
      "cid": "a78b0190",
      "sentence": "You'd better work harder.",
      "translation": "你应该更加努力工作。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 38
    },
    {
      "cid": "a3f381d0",
      "sentence": "I'm a workaholic.",
      "translation": "我是个工作狂。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 39
    },
    {
      "cid": "fcf64dcf",
      "sentence": "I don't know how to fill out this form.",
      "translation": "我不知道这张表怎么填。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 40
    },
    {
      "cid": "66f5dd55",
      "sentence": "How do I fill out this form?",
      "translation": "这张表怎么填?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 41
    },
    {
      "cid": "fde31956",
      "sentence": "Can you help me with this form?",
      "translation": "您能帮我填一下这张表吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 42
    },
    {
      "cid": "8dbfabbc",
      "sentence": "It looks like it's going to be a long meeting, doesn't it?",
      "translation": "看来会议要开长时间了，是吧?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 43
    },
    {
      "cid": "7709f28b",
      "sentence": "The meeting went well.",
      "translation": "会议开得很成功。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 44
    },
    {
      "cid": "6328e4e9",
      "sentence": "I did all I could do.",
      "translation": "我已经尽了最大的努力了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 45
    },
    {
      "cid": "077dc857",
      "sentence": "Are you impressed?",
      "translation": "你觉得印象深刻吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 46
    },
    {
      "cid": "026dbe80",
      "sentence": "Please underline the important items.",
      "translation": "请在重要事项的下面划线。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 47
    },
    {
      "cid": "2a23336b",
      "sentence": "Check.",
      "translation": "好，没问题!",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 48
    },
    {
      "cid": "2446e728",
      "sentence": "Would you get to the point?",
      "translation": "你能把要点说得再清楚点儿吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 49
    },
    {
      "cid": "7572409a",
      "sentence": "Please do it all over again.",
      "translation": "全部重做。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 50
    },
    {
      "cid": "7cde5024",
      "sentence": "Fax this paper to Mr. Tanaka.",
      "translation": "把这个给田中先生传真过去。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 51
    },
    {
      "cid": "ef02e9b8",
      "sentence": "Please hand the document in to me.",
      "translation": "请把那份文件交给我。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 52
    },
    {
      "cid": "75e5c215",
      "sentence": "This is a piece of work I can be proud of.",
      "translation": "这是我的得意之作。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 53
    },
    {
      "cid": "09c5ab7c",
      "sentence": "I can't find my white-out.",
      "translation": "我找不到我的涂改液了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 54
    },
    {
      "cid": "e473d13e",
      "sentence": "Are you working overtime tonight?",
      "translation": "今晚你加班吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 55
    },
    {
      "cid": "1b6ced71",
      "sentence": "Business is business.",
      "translation": "工作就是工作，不能讲私情。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 56
    },
    {
      "cid": "3264ce08",
      "sentence": "He's a hard worker.",
      "translation": "他是个努力工作的人。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 57
    },
    {
      "cid": "5f439671",
      "sentence": "You're overworking.",
      "translation": "你超负荷工作了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 58
    },
    {
      "cid": "1d5002a0",
      "sentence": "Finish this report today!",
      "translation": "今天必须完成这份报告。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 59
    },
    {
      "cid": "babbeff5",
      "sentence": "When is the paper due?",
      "translation": "报告截止到几号?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 60
    },
    {
      "cid": "f02cf586",
      "sentence": "There's a lot of work piled up on my desk.",
      "translation": "瞧我桌上堆了一堆的事儿。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 61
    },
    {
      "cid": "443c1682",
      "sentence": "We'll fake it.",
      "translation": "差不多就得了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 62
    },
    {
      "cid": "224233b7",
      "sentence": "All done!",
      "translation": "全都做完了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 63
    },
    {
      "cid": "f4b8e915",
      "sentence": "It's been a long day.",
      "translation": "今天忙了一天。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 64
    },
    {
      "cid": "a49f5dfd",
      "sentence": "I can't make an exception for you.",
      "translation": "我不能为你破例。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 65
    },
    {
      "cid": "3b35cd69",
      "sentence": "It's dark outside already.",
      "translation": "外边天都黑了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 66
    },
    {
      "cid": "27df0bf6",
      "sentence": "Let's finish up.",
      "translation": "就干到这儿吧。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 67
    },
    {
      "cid": "95d1d6ed",
      "sentence": "I've just finished work.",
      "translation": "正好工作刚做完。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 68
    },
    {
      "cid": "5b11c57f",
      "sentence": "Today's payday!",
      "translation": "今天发工资。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 69
    },
    {
      "cid": "548acc6f",
      "sentence": "Let's have a drink.",
      "translation": "我们一起去喝一杯吧。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 70
    },
    {
      "cid": "6dcfa5da",
      "sentence": "Thanks for your hard work.",
      "translation": "你辛苦了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 71
    },
    {
      "cid": "4f874ff5",
      "sentence": "I hope you don't mind my leaving now.",
      "translation": "我先走了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 72
    },
    {
      "cid": "546ff738",
      "sentence": "Sorry for interrupting.",
      "translation": "对不起，打断一下。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 73
    },
    {
      "cid": "ae7d10ce",
      "sentence": "May I interrupt you?",
      "translation": "打扰一下可以吗?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 74
    },
    {
      "cid": "09571966",
      "sentence": "Mr. Smith is on line one.",
      "translation": "史密斯先生在1号线听电话。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 75
    },
    {
      "cid": "e1671ff5",
      "sentence": "I have an appointment with Mr. Aoki.",
      "translation": "我已经和青木先生约好了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 76
    },
    {
      "cid": "9334c14d",
      "sentence": "What floor is ABC on?",
      "translation": "ABC公司在几楼?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 77
    },
    {
      "cid": "10e6543f",
      "sentence": "Where are the elevators?",
      "translation": "电梯在哪儿?",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 78
    },
    {
      "cid": "5cac61f5",
      "sentence": "What time do you get off work?",
      "translation": "你几点下班？",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 79
    },
    {
      "cid": "99c40243",
      "sentence": "I have a meeting at three this afternoon.",
      "translation": "我今天下午三点有个会。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 80
    },
    {
      "cid": "bd1383e5",
      "sentence": "Is the meeting still on for tomorrow?",
      "translation": "明天的会还照常开吗？",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 81
    },
    {
      "cid": "13fee10d",
      "sentence": "I'm afraid I have to ask for a day off.",
      "translation": "恐怕我得请一天假。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 82
    },
    {
      "cid": "4d2656c9",
      "sentence": "Could we reschedule the meeting to Friday?",
      "translation": "我们能把会议改到周五吗？",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 83
    },
    {
      "cid": "ddff4543",
      "sentence": "I'll get back to you by the end of the day.",
      "translation": "我今天之内会回复你。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 84
    },
    {
      "cid": "4cb79c53",
      "sentence": "I took that job.",
      "translation": "我接受了那份工作。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 85
    },
    {
      "cid": "b45ed857",
      "sentence": "It's close to me.",
      "translation": "离我很近。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 86
    },
    {
      "cid": "4eb3eb33",
      "sentence": "The pay is good.",
      "translation": "薪水不错。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 87
    },
    {
      "cid": "bc810920",
      "sentence": "You got a minute?",
      "translation": "你有空吗？",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 88
    },
    {
      "cid": "ddab755e",
      "sentence": "Sure, what's up?",
      "translation": "有，怎么了？",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 89
    },
    {
      "cid": "a732da43",
      "sentence": "I'm not on today.",
      "translation": "我今天不上班。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 90
    },
    {
      "cid": "1da8e217",
      "sentence": "It's my day off.",
      "translation": "我今天休息。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 91
    },
    {
      "cid": "f2c5b8eb",
      "sentence": "Are you off tomorrow?",
      "translation": "你明天休息吗？",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 92
    },
    {
      "cid": "dfcf2e40",
      "sentence": "I don't work Friday.",
      "translation": "我周五不上班。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 93
    },
    {
      "cid": "2e8d5895",
      "sentence": "I've been so busy.",
      "translation": "我最近太忙了。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 94
    },
    {
      "cid": "5010e8ef",
      "sentence": "Sometimes I forget.",
      "translation": "有时候会忘。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 95
    },
    {
      "cid": "475674ed",
      "sentence": "Can I go home early?",
      "translation": "我能早点回家吗？",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 96
    },
    {
      "cid": "b4cd5f6b",
      "sentence": "What time will you finish?",
      "translation": "你什么时候结束？",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 97
    },
    {
      "cid": "9a127097",
      "sentence": "I'll finish at two.",
      "translation": "我两点结束。",
      "sourceUrl": "content/oral-1-5-1/oral-001-e9de229d53f9.json",
      "sourceOffset": 98
    }
  ]
}
