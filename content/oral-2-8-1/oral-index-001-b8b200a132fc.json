  "items": [
    {
      "cid": "77588aab",
      "sentence": "How was your weekend?",
      "translation": "你周末过得怎么样？",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 0
    },
    {
      "cid": "78b2ed9c",
      "sentence": "I haven't seen you for ages.",
      "translation": "好久不见了。",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 1
    },
    {
      "cid": "243188cb",
      "sentence": "What's up?",
      "translation": "怎么了？/最近怎么样？",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 2
    },
    {
      "cid": "e53f3d82",
      "sentence": "Long time no see.",
      "translation": "好久不见。",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 3
    },
    {
      "cid": "4fad1198",
      "sentence": "It's been a while.",
      "translation": "已经有一阵子了。",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 4
    },
    {
      "cid": "129c08c0",
      "sentence": "How are you doing these days?",
      "translation": "你最近过得怎么样？",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 5
    },
    {
      "cid": "c530aed7",
      "sentence": "How ya doin'?",
      "translation": "最近怎么样？",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 6
    },
    {
      "cid": "c869e3f3",
      "sentence": "Not too bad.",
      "translation": "还不错。",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 7
    },
    {
      "cid": "ac537f80",
      "sentence": "You moved?",
      "translation": "你搬家了？",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 8
    },
    {
      "cid": "b0368ee8",
      "sentence": "Yes, nice place.",
      "translation": "是的，好地方。",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 9
    },
    {
      "cid": "7cccaf62",
      "sentence": "Sounds real nice.",
      "translation": "听起来不错。",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 10
    },
    {
      "cid": "af4c7939",
      "sentence": "Kids okay?",
      "translation": "孩子们还好吗？",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
      "sourceOffset": 11
    },
    {
      "cid": "c0abf276",
      "sentence": "Yeah, they're fine.",
      "translation": "嗯，他们都好。",
      "sourceUrl": "content/oral-2-8-1/oral-001-833da00354ab.json",
