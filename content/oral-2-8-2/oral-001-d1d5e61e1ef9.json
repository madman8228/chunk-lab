      "sentence": "I'll give you a call when I get home.",
      "cid": "efb3c8ea",
      "translation": "我到家后给你打电话。",
      "chunks": [
        "I'll give you a call",
        "when I get home."
      ],
      "hints": [
        "我会给你打电话",
        "当我到家时"
      ],
      "grammar": [
        {
          "role": "主句",
          "color": "#e74c7a",
          "phonetic": [
            "/aɪl/",
            "/ɡɪv/",
            "/juː/",
