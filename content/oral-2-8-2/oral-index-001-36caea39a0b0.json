{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "efb3c8ea",
      "sentence": "I'll give you a call when I get home.",
      "translation": "我到家后给你打电话。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 0
    },
    {
      "cid": "3edf0897",
      "sentence": "It was really nice talking to you.",
      "translation": "和你聊天真的很愉快。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 1
    },
    {
      "cid": "f2d8d822",
      "sentence": "Sorry, I have to go now.",
      "translation": "抱歉，我得走了。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 2
    },
    {
      "cid": "d1a382b8",
      "sentence": "I'm on my way.",
      "translation": "我在路上了。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 3
    },
    {
      "cid": "6b70763b",
      "sentence": "See you later, take care.",
      "translation": "回头见，保重。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 4
    },
    {
      "cid": "4c95b52c",
      "sentence": "Let's stay in touch, okay?",
      "translation": "我们保持联系，好吗？",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 5
    },
    {
      "cid": "f22bd74d",
      "sentence": "Sorry I'm late, the traffic was terrible.",
      "translation": "抱歉我迟到了，路上堵得厉害。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 6
    },
    {
      "cid": "8eea26b2",
      "sentence": "I'll be there in about ten minutes.",
      "translation": "我大约十分钟后到。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 7
    },
    {
      "cid": "f1405f3f",
      "sentence": "I brought you apples.",
      "translation": "我给你带了苹果。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 8
    },
    {
      "cid": "13553af7",
      "sentence": "This is way too much.",
      "translation": "这太多了。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 9
    },
    {
      "cid": "2af7c066",
      "sentence": "It's partly rotten.",
      "translation": "有点坏了。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 10
    },
    {
      "cid": "2ca094db",
      "sentence": "Bite that piece off.",
      "translation": "把那块咬下来。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 11
    },
    {
      "cid": "46bc4117",
      "sentence": "I'm coming to get you.",
      "translation": "我来接你了。",
      "sourceUrl": "content/oral-2-8-2/oral-001-d1d5e61e1ef9.json",
      "sourceOffset": 12
    }
  ]
}
