{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "876376ff",
      "sentence": "Maybe.",
      "translation": "也许吧。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 0
    },
    {
      "cid": "6bb77304",
      "sentence": "Not exactly.",
      "translation": "不完全。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 1
    },
    {
      "cid": "ead6c269",
      "sentence": "I guess so.",
      "translation": "可能是吧!",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 2
    },
    {
      "cid": "11dc9036",
      "sentence": "It might be true.",
      "translation": "也许是真的吧。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 3
    },
    {
      "cid": "5f3ebc60",
      "sentence": "It could be.",
      "translation": "可能会吧。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 4
    },
    {
      "cid": "b8516454",
      "sentence": "I'm not sure.",
      "translation": "我不太清楚。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 5
    },
    {
      "cid": "fd63da79",
      "sentence": "I hope you're right.",
      "translation": "但愿是这样。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 6
    },
    {
      "cid": "e5b545b8",
      "sentence": "Sort of.",
      "translation": "有那么点儿。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 7
    },
    {
      "cid": "7eaf07fc",
      "sentence": "It's something like that.",
      "translation": "差不多吧!",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 8
    },
    {
      "cid": "91e2af23",
      "sentence": "It depends.",
      "translation": "那得看情况。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 9
    },
    {
      "cid": "af96a1bf",
      "sentence": "Maybe yes, maybe no.",
      "translation": "也许是，也许不是。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 10
    },
    {
      "cid": "ae2957ed",
      "sentence": "Hopefully.",
      "translation": "但愿能去。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 11
    },
    {
      "cid": "d6e7e38a",
      "sentence": "There's no guarantee.",
      "translation": "不能保证。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 12
    },
    {
      "cid": "b81dea8c",
      "sentence": "I can't say.",
      "translation": "我说不好。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 13
    },
    {
      "cid": "9892163a",
      "sentence": "Yes and no.",
      "translation": "也是也不是。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 14
    },
    {
      "cid": "766605fc",
      "sentence": "Half and half.",
      "translation": "喜忧参半。/一半一半。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 15
    },
    {
      "cid": "f9379b06",
      "sentence": "I'll try.",
      "translation": "我会试试。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 16
    },
    {
      "cid": "f632db58",
      "sentence": "It's difficult to say.",
      "translation": "怎么说呢。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 17
    },
    {
      "cid": "e818f7e3",
      "sentence": "Could be better.",
      "translation": "还可以更好点。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 18
    },
    {
      "cid": "da0547f2",
      "sentence": "He gave me an ambiguous answer.",
      "translation": "他给我的回答很含糊。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 19
    },
    {
      "cid": "f50d7898",
      "sentence": "Let me think about it.",
      "translation": "让我考虑一下。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 20
    },
    {
      "cid": "8f7e05cb",
      "sentence": "I need some time to think it over.",
      "translation": "请给我点儿时间考虑。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 21
    },
    {
      "cid": "be17b471",
      "sentence": "I'll consider it.",
      "translation": "我会考虑的。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 22
    },
    {
      "cid": "ee420d0d",
      "sentence": "I'll think about it.",
      "translation": "我考虑考虑吧。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 23
    },
    {
      "cid": "9c0bc01e",
      "sentence": "I'll think it over.",
      "translation": "我得琢磨琢磨。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 24
    },
    {
      "cid": "5d4f9d11",
      "sentence": "Let me sleep on it.",
      "translation": "请给我一个晚上的时间考虑。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 25
    },
    {
      "cid": "abc317f8",
      "sentence": "I'll see what I can do.",
      "translation": "我看看能做点什么。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 26
    },
    {
      "cid": "4c042890",
      "sentence": "How about you?",
      "translation": "你呢?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 27
    },
    {
      "cid": "2e87dc8c",
      "sentence": "What do you think?",
      "translation": "你觉得呢?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 28
    },
    {
      "cid": "3956576f",
      "sentence": "What's your opinion?",
      "translation": "你的意见呢?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 29
    },
    {
      "cid": "81004cd1",
      "sentence": "What's your suggestion?",
      "translation": "你的建议呢?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 30
    },
    {
      "cid": "b534d5c5",
      "sentence": "What else?",
      "translation": "还有别的吗?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 31
    },
    {
      "cid": "ae8f2178",
      "sentence": "Any question will do.",
      "translation": "什么问题都可以。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 32
    },
    {
      "cid": "74b6650e",
      "sentence": "What do you recommend?",
      "translation": "你有什么建议吗?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 33
    },
    {
      "cid": "4b853871",
      "sentence": "Don't you think so?",
      "translation": "你不这样认为吗?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 34
    },
    {
      "cid": "bf1f2dac",
      "sentence": "Do you agree?",
      "translation": "你同意吗?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 35
    },
    {
      "cid": "07b2a1d7",
      "sentence": "Give me a definite answer.",
      "translation": "给我一个明确的答复。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 36
    },
    {
      "cid": "e64e967e",
      "sentence": "Is it “yes” or “no”?",
      "translation": "“是”还是“不是”?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 37
    },
    {
      "cid": "30b1bc20",
      "sentence": "It doesn't answer my question.",
      "translation": "这可不算答复。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 38
    },
    {
      "cid": "0dea6d73",
      "sentence": "You don't stand a chance.",
      "translation": "你没有希望赢。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 39
    },
    {
      "cid": "0938bec6",
      "sentence": "It's the last straw.",
      "translation": "我已经忍无可忍了。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 40
    },
    {
      "cid": "c6409e82",
      "sentence": "Let me hear your candid opinion.",
      "translation": "让我听听您的直言。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 41
    },
    {
      "cid": "9ad8ca04",
      "sentence": "Can you think of anything better?",
      "translation": "你有什么更好的主意吗?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 42
    },
    {
      "cid": "b97217fe",
      "sentence": "Any complaints?",
      "translation": "有什么不满意的吗?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 43
    },
    {
      "cid": "cd693d06",
      "sentence": "What is your complaint?",
      "translation": "你不满意什么?",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 44
    },
    {
      "cid": "791e8b89",
      "sentence": "I'm fairly broad-minded.",
      "translation": "我是个有气量的人。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 45
    },
    {
      "cid": "5b22aa74",
      "sentence": "That kind of chance comes once in a blue moon.",
      "translation": "这是一个难得的机会。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 46
    },
    {
      "cid": "ab1f545c",
      "sentence": "In my opinion...",
      "translation": "照我的想法……",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 47
    },
    {
      "cid": "20fa630c",
      "sentence": "What I meant was...",
      "translation": "我的意思是……",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 48
    },
    {
      "cid": "cddb04a2",
      "sentence": "I don't think so.",
      "translation": "我想不是。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 49
    },
    {
      "cid": "cb2fa33a",
      "sentence": "I think it is a matter of opinion.",
      "translation": "我认为这要看个人的看法。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 50
    },
    {
      "cid": "d37b7865",
      "sentence": "It's not important.",
      "translation": "那并不重要。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 51
    },
    {
      "cid": "738f5fd5",
      "sentence": "That's a good idea.",
      "translation": "那是个好主意。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 52
    },
    {
      "cid": "ddbd34c9",
      "sentence": "That's not true.",
      "translation": "那是胡说。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 53
    },
    {
      "cid": "5b59f084",
      "sentence": "I can't afford it.",
      "translation": "我可负担不起。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 54
    },
    {
      "cid": "1f967e9a",
      "sentence": "It's worth a look.",
      "translation": "值得一看。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 55
    },
    {
      "cid": "665b7a3b",
      "sentence": "You see...",
      "translation": "这不，你看……",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 56
    },
    {
      "cid": "f48260cc",
      "sentence": "Let's get this straight.",
      "translation": "我可跟你说清楚。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 57
    },
    {
      "cid": "bdbf175c",
      "sentence": "I would not do that.",
      "translation": "我是不会做那种事儿的。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 58
    },
    {
      "cid": "16643f71",
      "sentence": "You ain't seen nothing yet.",
      "translation": "还有更厉害的呢。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 59
    },
    {
      "cid": "d91a9c46",
      "sentence": "Let's leave well enough alone.",
      "translation": "不要画蛇添足了。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 60
    },
    {
      "cid": "1dde6d78",
      "sentence": "It must be my imagination.",
      "translation": "肯定是我的幻觉。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 61
    },
    {
      "cid": "b26f5732",
      "sentence": "In the long run,...",
      "translation": "从长远来看……",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 62
    },
    {
      "cid": "806439ee",
      "sentence": "I'm not sure about that.",
      "translation": "我不太确定那件事。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 63
    },
    {
      "cid": "fb54ce6f",
      "sentence": "It's up to you.",
      "translation": "由你决定。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 64
    },
    {
      "cid": "0951976a",
      "sentence": "It's up to you, I'm fine either way.",
      "translation": "你决定吧，我怎么样都行。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 65
    },
    {
      "cid": "5a4799a1",
      "sentence": "You're in charge.",
      "translation": "你说了算。",
      "sourceUrl": "content/oral-3-12-2/oral-001-a881417ab4f8.json",
      "sourceOffset": 66
    }
  ]
}
