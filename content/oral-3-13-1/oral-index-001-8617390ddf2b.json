{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "584dc1a3",
      "sentence": "Do you mind if I ask you a favor?",
      "translation": "我可以请您帮个忙吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 0
    },
    {
      "cid": "57288de5",
      "sentence": "Would you give me a hand?",
      "translation": "能帮把手吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 1
    },
    {
      "cid": "9705ac23",
      "sentence": "I'm sorry to bother you,...",
      "translation": "对不起……",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 2
    },
    {
      "cid": "20f090fd",
      "sentence": "I'll be glad to.",
      "translation": "乐意为您效劳。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 3
    },
    {
      "cid": "4d6864d7",
      "sentence": "Could I possibly...?",
      "translation": "我可不可以……/可不可以让我……",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 4
    },
    {
      "cid": "3b347863",
      "sentence": "If you'd like,...",
      "translation": "如果可以的话，……",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 5
    },
    {
      "cid": "0e829cd6",
      "sentence": "Could you pass the sugar, please?",
      "translation": "请您把糖拿过来行吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 6
    },
    {
      "cid": "41201124",
      "sentence": "Here you are.",
      "translation": "给。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 7
    },
    {
      "cid": "3b12afb6",
      "sentence": "Please do this.",
      "translation": "请做这个。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 8
    },
    {
      "cid": "3dd6d29d",
      "sentence": "Would you drive me to the store?",
      "translation": "您能开车送我到那家店吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 9
    },
    {
      "cid": "4e88bbba",
      "sentence": "Would you help me find the number for the ABC Hotel?",
      "translation": "您能帮我找到ABC饭店的电话号码吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 10
    },
    {
      "cid": "fa523767",
      "sentence": "May I borrow your pen?",
      "translation": "能借用一下你的钢笔吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 11
    },
    {
      "cid": "31c1b2ac",
      "sentence": "Do you have a pen?",
      "translation": "有笔吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 12
    },
    {
      "cid": "2a1d5c8c",
      "sentence": "Can you lend me ten dollars?",
      "translation": "能借给我10美元吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 13
    },
    {
      "cid": "a66ef75a",
      "sentence": "Would you give me a call?",
      "translation": "你能给我打个电话吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 14
    },
    {
      "cid": "cfcfc094",
      "sentence": "I'd appreciate it if you could call me tonight.",
      "translation": "你今天晚上如果能给我打个电话的话，我将非常感激。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 15
    },
    {
      "cid": "3b6aef29",
      "sentence": "Please turn it down.",
      "translation": "请关小点儿声。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 16
    },
    {
      "cid": "e0950cd6",
      "sentence": "Wait here until I get back.",
      "translation": "等我回来。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 17
    },
    {
      "cid": "4c6b7772",
      "sentence": "Hello, there!",
      "translation": "喂，你!",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 18
    },
    {
      "cid": "058292d4",
      "sentence": "Hey!",
      "translation": "喂!",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 19
    },
    {
      "cid": "8a34f44d",
      "sentence": "Do you have time?",
      "translation": "你有空吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 20
    },
    {
      "cid": "db584c0c",
      "sentence": "Can I ask you a favor?",
      "translation": "我想求你件事行吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 21
    },
    {
      "cid": "70dd88dc",
      "sentence": "May I ask you something?",
      "translation": "我想打听点儿事。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 22
    },
    {
      "cid": "5ba92df9",
      "sentence": "Guess what?",
      "translation": "你猜怎么着?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 23
    },
    {
      "cid": "4d14acbc",
      "sentence": "Sorry, I mistook you for someone else.",
      "translation": "对不起，我认错人了。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 24
    },
    {
      "cid": "2a4e8042",
      "sentence": "How should I do it?",
      "translation": "我该怎么做呢?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 25
    },
    {
      "cid": "2cfabe71",
      "sentence": "This is the way you should do it.",
      "translation": "你该这么做。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 26
    },
    {
      "cid": "3fdae928",
      "sentence": "It'll do the trick.",
      "translation": "这样的话就会很顺利。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 27
    },
    {
      "cid": "5b325f49",
      "sentence": "This looks better.",
      "translation": "这样看上去好一些。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 28
    },
    {
      "cid": "be1ace8a",
      "sentence": "I'll do it my own way.",
      "translation": "我用我自己的办法。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 29
    },
    {
      "cid": "bb0166d7",
      "sentence": "Like this?",
      "translation": "像这样?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 30
    },
    {
      "cid": "d18ff455",
      "sentence": "Like what?",
      "translation": "像什么?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 31
    },
    {
      "cid": "6f69b362",
      "sentence": "It's easy.",
      "translation": "很简单。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 32
    },
    {
      "cid": "02554296",
      "sentence": "Just like that!",
      "translation": "简单得不得了。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 33
    },
    {
      "cid": "9857b1ba",
      "sentence": "It's a little hard.",
      "translation": "有点儿难哦。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 34
    },
    {
      "cid": "642f82cf",
      "sentence": "It's complicated.",
      "translation": "很复杂哦。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 35
    },
    {
      "cid": "6e4ea586",
      "sentence": "This is the first thing to do.",
      "translation": "首先应该做这个。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 36
    },
    {
      "cid": "cb059180",
      "sentence": "You dropped this.",
      "translation": "你掉了这个。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 37
    },
    {
      "cid": "494227a3",
      "sentence": "I think you dropped this.",
      "translation": "我想这是你丢的吧!",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 38
    },
    {
      "cid": "06397cd4",
      "sentence": "Is this yours?",
      "translation": "这是你的吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 39
    },
    {
      "cid": "927a5ea7",
      "sentence": "Isn't this yours?",
      "translation": "这不是你的吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 40
    },
    {
      "cid": "18091091",
      "sentence": "It's mine.",
      "translation": "是我的。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 41
    },
    {
      "cid": "01d78d95",
      "sentence": "I've lost my wallet.",
      "translation": "我的钱包丢了。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 42
    },
    {
      "cid": "428b28ff",
      "sentence": "I'm in trouble!",
      "translation": "这下可麻烦了。。。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 43
    },
    {
      "cid": "75857a9d",
      "sentence": "May I help?",
      "translation": "要我帮忙吗?/要我帮你拿吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 44
    },
    {
      "cid": "0f1ea513",
      "sentence": "Think twice before you decide.",
      "translation": "决定之前再好好考虑考虑。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 45
    },
    {
      "cid": "ed66ca29",
      "sentence": "How about this one?",
      "translation": "这个怎么样?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 46
    },
    {
      "cid": "0a396236",
      "sentence": "I want to make a suggestion.",
      "translation": "我提个建议。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 47
    },
    {
      "cid": "0ce7578c",
      "sentence": "Let's take a short cut.",
      "translation": "我们走近道吧!",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 48
    },
    {
      "cid": "45dabaff",
      "sentence": "Let's play hooky!",
      "translation": "咱们逃学吧!",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 49
    },
    {
      "cid": "1c1145af",
      "sentence": "Let's call in sick.",
      "translation": "我们打电话请个病假吧!",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 50
    },
    {
      "cid": "cce92168",
      "sentence": "Let's play cards!",
      "translation": "玩扑克吧!",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 51
    },
    {
      "cid": "1f99d5da",
      "sentence": "I have an idea.",
      "translation": "我有个主意。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 52
    },
    {
      "cid": "8583075d",
      "sentence": "Tell you what.",
      "translation": "这样怎么样?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 53
    },
    {
      "cid": "621a5b36",
      "sentence": "Let me think for a moment.",
      "translation": "让我考虑一下。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 54
    },
    {
      "cid": "cec19e0f",
      "sentence": "Just think about it.",
      "translation": "你好好想想看。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 55
    },
    {
      "cid": "272cc2a2",
      "sentence": "You should get a haircut.",
      "translation": "你该剪剪你的头发了。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 56
    },
    {
      "cid": "48387ff4",
      "sentence": "Won't you join us?",
      "translation": "你也一起来吧?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 57
    },
    {
      "cid": "0c75c62e",
      "sentence": "What do you suggest?",
      "translation": "你有什么建议吗?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 58
    },
    {
      "cid": "e9893d2f",
      "sentence": "Wanna make a bet?",
      "translation": "打赌?",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 59
    },
    {
      "cid": "2e8aa9e5",
      "sentence": "I suggest you take a taxi.",
      "translation": "我建议你坐出租车去。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 60
    },
    {
      "cid": "a71c1752",
      "sentence": "Can you give me a hand?",
      "translation": "能帮我一下吗？",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 61
    },
    {
      "cid": "534483e8",
      "sentence": "Could you do me a favor?",
      "translation": "你能帮我个忙吗？",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 62
    },
    {
      "cid": "10dca05a",
      "sentence": "Could you give me a hand with this box?",
      "translation": "你能帮我搬一下这个箱子吗？",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 63
    },
    {
      "cid": "1792dc97",
      "sentence": "I need help.",
      "translation": "我需要帮助。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 64
    },
    {
      "cid": "9187c8c7",
      "sentence": "Lend me 10 bucks.",
      "translation": "借我10块钱。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 65
    },
    {
      "cid": "fc023e5e",
      "sentence": "I want my money.",
      "translation": "还我钱。",
      "sourceUrl": "content/oral-3-13-1/oral-001-2effeadf8664.json",
      "sourceOffset": 66
    }
  ]
}
