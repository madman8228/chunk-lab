{
  "schemaVersion": 1,
  "mode": "index",
  "items": [
    {
      "cid": "ea178218",
      "sentence": "Don't worry about it.",
      "translation": "别担心/没事的。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 0
    },
    {
      "cid": "22a86a18",
      "sentence": "Take your time.",
      "translation": "慢慢来/别着急。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 1
    },
    {
      "cid": "f138b191",
      "sentence": "As long as you're happy, that's all that matters.",
      "translation": "只要你开心，其他都不重要。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 2
    },
    {
      "cid": "c66af01f",
      "sentence": "Cheer up, it's not the end of the world.",
      "translation": "打起精神来，又不是世界末日。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 3
    },
    {
      "cid": "b6a7287e",
      "sentence": "Don't worry, everything will work out fine.",
      "translation": "别担心，一切都会好起来的。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 4
    },
    {
      "cid": "79d9ff2f",
      "sentence": "No matter what happens, I'll be here for you.",
      "translation": "无论发生什么，我都会在你身边。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 5
    },
    {
      "cid": "1417566d",
      "sentence": "Take your time, there's no rush.",
      "translation": "慢慢来，不用急。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 6
    },
    {
      "cid": "b088786f",
      "sentence": "What's bothering you?",
      "translation": "什么事烦你了？",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 7
    },
    {
      "cid": "85107210",
      "sentence": "You'll be fine.",
      "translation": "你会没事的。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 8
    },
    {
      "cid": "21f94209",
      "sentence": "Don't beat yourself up.",
      "translation": "别太苛责自己。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 9
    },
    {
      "cid": "cd379d3e",
      "sentence": "I've been there.",
      "translation": "我是过来人。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 10
    },
    {
      "cid": "9042ad50",
      "sentence": "I'm here for you.",
      "translation": "我陪你。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 11
    },
    {
      "cid": "d989d51c",
      "sentence": "Hope you're feeling better.",
      "translation": "希望你好点了。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 12
    },
    {
      "cid": "45b93a39",
      "sentence": "Just relax.",
      "translation": "放松一下。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 13
    },
    {
      "cid": "6010cb80",
      "sentence": "Don't be sad.",
      "translation": "别伤心。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 14
    },
    {
      "cid": "ac89bfd8",
      "sentence": "Get yourself together.",
      "translation": "振作起来。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 15
    },
    {
      "cid": "77eefd93",
      "sentence": "Let me hug you.",
      "translation": "让我抱抱你。",
      "sourceUrl": "content/oral-4-20/oral-001-b9b3ddca2467.json",
      "sourceOffset": 16
    }
  ]
}
