      "sentence": "Could you tell me how to get to the station?",
      "cid": "4226408e",
      "translation": "你能告诉我怎么去车站吗？",
      "chunks": [
        "Could you tell me",
        "how to get",
        "to the station?"
      ],
      "hints": [
        "你能告诉我吗",
        "怎么去",
        "到车站"
      ],
      "grammar": [
        {
          "role": "主句谓语",
          "color": "#e74c7a",
          "phonetic": [
            "/kʊd/",
            "/juː/",
            "/tel/",
            "/miː/"
          ],
          "pos": "情态动词+宾语",
          "meaning": "你能告诉我"
        },
        {
          "role": "宾语从句",
          "color": "#3358e0",
          "phonetic": [
            "/haʊ/",
