  "usefulExpressions":{"sourceImages":[9,10],"units":[
    {"unitId":"unit-1","printedPage":86,"entries":[["Hurry up! Don't be late for class!","快点！上课别迟到！",""],["I'm ready. Let's go!","我准备好了。我们出发吧！",""],["Who's on duty today?","今天谁值日？",""],["I can put back the desks and chairs.","我可以把桌椅放回原位。",""],["Excuse me?","对不起，请再说一次可以吗？",""],["It's 5 o'clock.","现在五点了。",""],["Time to go home, kids.","孩子们，该回家了。",""],["It's time for dinner.","该吃晚饭了。",""],["It's time to get up.","该起床了。",""],["Have a nice day!","祝你一天愉快！",""]] },
    {"unitId":"unit-2","printedPage":86,"entries":[["Mum, can I watch TV?","妈妈，我能看电视吗？",""],["No. You have to do your homework first.","不行。你得先做作业。",""],["Shh. Don't be so loud!","嘘。别这么大声！",""],["Be careful, Jack. Don't touch hot things.","杰克，要小心。别碰烫的东西。",""]] },
    {"unitId":"unit-3","printedPage":86,"entries":[["What time is it?","几点了？",""]] },
    {"unitId":"unit-4","printedPage":86,"entries":[["Can I buy a new pair?","我能买条新的（裤子）吗？",""],["Sure. Let's go to the clothes shop.","当然。我们去服装店吧。",""],["You already have too many shorts. Let's buy trousers.","你已经有很多短裤了。我们买长裤吧。",""],["Can I help you?","要帮忙吗？",""],["Yes. I like this pink dress.","嗯。我喜欢这件粉色的长裙。",""],["Let's take it.","我们买下它吧。",""]] },
    {"unitId":"unit-5","printedPage":86,"entries":[["What animals do you have on the farm?","您的农场上都养了哪些动物？","该句英文在 p.86，中文译文续于 p.87。"],["I have a lot of animals.","我养了很多动物。",""],["What are these?","这些是什么？",""],["They're tomatoes.","这些是西红柿。",""],["How fresh!","真新鲜啊！",""]] },
    {"unitId":"unit-6","printedPage":87,"entries":[["Let's feed the chickens.","我们喂鸡吧。",""],["Can you please pass me the vegetables?","能否请你把蔬菜递给我？",""],["Mike, Amy, would you like a knife and fork?","迈克、埃米，你们需要餐刀和餐叉吗？",""],["No, thank you, Mr Wang. I can use chopsticks.","不用，谢谢您，王先生。我会用筷子。",""],["Don't waste food, please.","请不要浪费食物。",""]] }
  ]},
