# Chunk Lab 云端后端环境变量模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 本地调试启动：node -r ./loadenv.js index.js

# 运行模式：true = 多用户（需注册登录 + JWT）；false = 开放模式（落到单默认用户，免登录）
# ⚠️ 任何公网/可访问网络部署都必须设为 true，否则数据裸奔、可被任意覆盖。
REQUIRE_AUTH=true

# JWT 签名密钥（必填且要足够随机；生产环境用强随机值，例如：openssl rand -hex 32）
# ⚠️ 这是安全底线，绝不能用默认值上线。
JWT_SECRET=change-me-to-a-long-random-string

# 登录令牌有效期（可选，默认 30d）
TOKEN_TTL=30d

# 允许的前端来源（逗号分隔；生产用 Nginx 反向代理时填前端域名；留空 = 开发期全允许）
CORS_ORIGINS=

# 服务端口（可选，默认 8787）
PORT=8787

# 数据库目录（可选，默认 server/data）；生产建议指向持久卷
CHUNKLAB_DATA_DIR=
