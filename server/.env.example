# Chunk Lab 云端后端环境变量模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 本地调试启动：node -r ./loadenv.js index.js

# 运行模式：true = 多用户（需注册登录 + JWT）；false = 开放模式（落到单默认用户，免登录）
# ⚠️ 任何公网/可访问网络部署都必须设为 true，否则数据裸奔、可被任意覆盖。
# ⚠️ NODE_ENV=production 时若 REQUIRE_AUTH 非 true，服务会拒绝启动（P0 断言，2026-09-09）。
REQUIRE_AUTH=true

# 运行环境：production = 生产（强制 REQUIRE_AUTH=true，见上）；本地开发可不设
NODE_ENV=production

# JWT 签名密钥（必填，生产用强随机值，例如：openssl rand -hex 32；少于 32 字符直接拒绝启动）
# ⚠️ 这是安全底线，绝不能用默认值上线。
JWT_SECRET=change-me-to-a-long-random-string

# 登录令牌有效期（可选，默认 30d）
TOKEN_TTL=30d

# 允许的前端来源（逗号分隔；生产用 Nginx 反向代理时填前端域名）
# ⚠️ 留空 = 拒绝所有跨域（fail-closed，2026-09-09）；前端与 API 同源部署无需 CORS。
CORS_ORIGINS=

# 是否位于反向代理之后（true 时信任第一跳 X-Forwarded-For 用于认证限速的 IP 识别；
# 直连部署务必留空，否则可被伪造 XFF 绕过限速）。默认 false。
TRUST_PROXY=false

# 服务端口（可选，默认 8787）
PORT=8787

# 数据库目录（可选，默认 server/data）；生产建议指向持久卷
CHUNKLAB_DATA_DIR=

# AI 联网生成开关（2026-09-06 产品决策：先禁联网 AI 生成）。true = 启用 /api/ai/explain；默认关闭 → 503
AI_EXPLAIN_ENABLED=false

# AI 详解缓存表容量上限（可选，默认 2000）；备份导入后按 LRU 淘汰最旧，防止无限膨胀
AI_CACHE_MAX=2000

# AI 缓存有效期（可选，默认 30 天；0 = 永不过期）；命中时过期视为未命中重新生成，写入时懒清理
AI_CACHE_TTL=30

# DeepSeek API Key（ADR-004 后端代理）。配置后 Key 不再进前端、明文 localStorage 不再需要。
# 留空则允许前端自托管传入自己的 Key（降级模式，生产建议配置此值）。
DEEPSEEK_API_KEY=

# AI 代理每用户每分钟限流次数（可选，默认 10）
AI_RATE_LIMIT=10
